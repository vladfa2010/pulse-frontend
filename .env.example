# Firebase web app config (for push notifications)
# Get these from Firebase Console → Project settings → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Analytics Measurement ID (Firebase Console → Project settings → Web app)
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push VAPID key (Firebase Console → Cloud Messaging → Web push certificates)
VITE_FIREBASE_VAPID_KEY=

# ТЗ-101: разъезд панели каскада под каруселью/лентой.
# unset или true → разъезд (панель под треком); false → переход на /cascades?cluster=<id>
# (interim-навигация ТЗ-100, контейнер не монтируется). Откат: поставить false.
VITE_CASCADE_EXPAND=
